{
  "schema_version": "1.1.0",
  "schema_purpose": "Canonical project brief for humans and AI agents. Prefer this file over chat history or prose docs when they conflict. Contains no secrets.",
  "project": {
    "name": "revel",
    "cli_name": "revelctl",
    "display_name": "Revel",
    "kind": "application",
    "visibility": "public",
    "status": "community_bootstrap",
    "credits": {
      "created_by": "StarMarketingTeam",
      "coded_with": "Grok (xAI)",
      "repository_owner": "landNull"
    },
    "repository": {
      "host": "github",
      "owner": "landNull",
      "name": "revel",
      "url": "https://github.com/landNull/revel",
      "default_branch": "main",
      "integration_branch": "devel"
    },
    "license": "AGPL-3.0-only",
    "licensing": {
      "community": "AGPL-3.0-only",
      "hosted_extras": "proprietary",
      "model": "open_core"
    },
    "development": {
      "host_distro": "Devuan Excalibur",
      "init_system": "sysvinit",
      "desktop": "Cinnamon",
      "role": "author workstation only",
      "not_a_requirement": true,
      "author_experience": "beginner with basic API concepts"
    }
  },
  "thesis": {
    "one_liner": "A project manager that treats every element as a task node."
  },
  "layers": {
    "order": ["graph", "store", "plane", "clients", "adapters"]
  },
  "core": {
    "must_serve": ["graph", "projection", "control_plane"],
    "graph": {
      "node_types": ["task", "project", "milestone", "file", "email", "event", "lead", "opportunity", "account", "contact", "ticket", "campaign", "content", "inventory_item", "knowledge_article", "user", "group"]
    },
    "projection": {
      "primary": "kanban",
      "also": ["calendar", "gantt", "list", "dashboard"],
      "column_field": "payload.column"
    },
    "control_plane": {
      "entry": "revelctl",
      "bootstrap": "api_first",
      "verbs": ["create", "link", "query", "list", "mutate", "board", "move", "cal", "gantt", "demo", "dashboard", "serve", "file", "whoami", "mail"]
    }
  },
  "paths": {
    "files_root": "~/Revel/files",
    "files_override": "REVEL_HOME",
    "store_xdg": "~/.local/share/revel/store",
    "config_xdg": "~/.config/revel",
    "mail_env": "~/.config/revel/mail.env"
  },
  "surfaces": {
    "cli": {"status": "active", "name": "revelctl"},
    "web": {
      "status": "active",
      "framework": "fastapi",
      "extra": "revel[web]",
      "chrome": "bootstrap5",
      "tokens": "src/revel/ui/static/revel.css",
      "calendar_theme": "fullcalendar bootstrap5"
    },
    "tui": {"status": "parked", "toolkit": "textual"},
    "desktop_efl": {"status": "rejected"},
    "ml_orange": {"status": "parked"}
  },
  "store": {
    "system_of_record": "graph",
    "default_engine": "file",
    "embedded": "kuzu",
    "scale_path": ["neo4j"],
    "not_system_of_record": ["sqlite", "mariadb", "django_orm"]
  },
  "adapters": {
    "items": [
      {"id": "fs", "status": "active", "issue": 21, "root": "~/Revel/files"},
      {"id": "os_users_groups", "status": "active", "issue": 23, "cli": "revelctl whoami"},
      {"id": "mail_imap_smtp", "status": "active", "issue": 22, "cli": "revelctl mail status|secret|fetch|send"},
      {"id": "graph_store", "status": "active"},
      {"id": "sql_store", "status": "parked"}
    ]
  },
  "packaging": {
    "distro_policy": "none",
    "preferred": ["wheel", "pipx", "container"]
  },
  "github": {
    "open_parent": 1
  },
  "decisions": [
    {"id": "D001", "status": "accepted", "title": "Python 3 is the core language"},
    {"id": "D002", "status": "accepted", "title": "Drop Enlite / EFL"},
    {"id": "D003", "status": "accepted", "title": "No first-class dependency on any single Linux distribution"},
    {"id": "D004", "status": "accepted", "title": "OS user/group mapping is an optional adapter"},
    {"id": "D005", "status": "accepted", "title": "Explicit graph store"},
    {"id": "D006", "status": "accepted", "title": "API-first"},
    {"id": "D007", "status": "accepted", "title": "FastAPI HTTP adapter"},
    {"id": "D008", "status": "accepted", "title": "AGPL-3.0 community; hosted extras proprietary"},
    {"id": "D009", "status": "parked", "title": "Orange and conda are not Revel"},
    {"id": "D010", "status": "parked", "title": "Textual TUI parked"},
    {"id": "D011", "status": "accepted", "title": "Artix and OpenRC are not project identity"},
    {"id": "D012", "status": "accepted", "title": "Web chrome is Bootstrap 5 plus revel.css tokens; widgets inherit tokens"}
  ],
  "out_of_scope": [
    "Enlite / EFL / Edje",
    "Named distro or init as a product requirement",
    "Orange / conda as runtime",
    "Secrets in this file or on graph nodes"
  ],
  "agent_instructions": {
    "read_this_file_first": true,
    "explain_for_beginner": true,
    "style": "treat every element as a task node",
    "do_not": [
      "Write passwords into the repo or this file",
      "Treat any distro or init as required",
      "Reintroduce Enlite or Orange into the stack"
    ]
  }
}
